# MongoDB
# Your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/madonna

# Cloudinary
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shopify
# Your Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token from Shopify
SHOPIFY_ACCESS_TOKEN=your_access_token
# Webhook secret for HMAC validation
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
# Shopify API version (use latest, e.g., 2024-10)
SHOPIFY_API_VERSION=2024-10

# Application
# Your application base URL (e.g., https://yourdomain.com or http://localhost:3000 for dev)
BASE_URL=http://localhost:3000
# Secret key for JWT token signing (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# SMTP (Nodemailer)
# Email service configuration for sending Moment Codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Sender email address
SMTP_FROM=noreply@yourdomain.com
# Contact form submissions are sent to this email (default: mbanwie@gmail.com if unset)
CONTACT_EMAIL=mbanwie@gmail.com

# Admin Seed
# Initial admin user credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here